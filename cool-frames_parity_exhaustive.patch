+def _is_filter_list(o):
+    return isinstance(o, list) and o and all(isinstance(x, dict) and "H" in x for x in o)
+
+
+def _filters_to_array(g, L):
+    """Evaluate a filter list to its frequency responses.
+
+    Filter dicts are not comparable field-by-field across backends: NumPy leaves
+    ``H`` as a *callable* for the auditory, CQT and wavelet designers and
+    materialises it for Gabor, while torch materialises everything as a tensor.
+    Both describe the same filter.  Evaluating is the comparison that means
+    something.
+    """
+    from cool_frames.numpy.filters import filter_freqresp
+
+    out = []
+    for gm in g:
+        gm_np = dict(gm)
+        H = gm_np.get("H")
+        if isinstance(H, torch.Tensor):
+            gm_np["H"] = H.detach().cpu().numpy()
+        foff = gm_np.get("foff")
+        if isinstance(foff, torch.Tensor):
+            gm_np["foff"] = int(foff.item())
+        Hf, off = filter_freqresp(gm_np, L)
+        buf = np.zeros(L, dtype=complex)
+        Hf = np.asarray(Hf).ravel()
+        idx = (np.arange(len(Hf)) + int(off)) % L
+        buf[idx] = Hf
+        out.append(buf)
+    return np.concatenate(out)
+
+
+def _designer_L(o):
+    """The ``L`` inside a designer's own return tuple, if this is one.
+
+    The filter designers return ``(g, a, fc, L, info)``, so when the object under
+    comparison *is* a designer's output, its own ``L`` is authoritative and
+    nothing needs inferring.
+    """
+    if len(o) >= 4 and _is_filter_list(o[0]) and isinstance(o[3], (int, np.integer)):
+        return int(o[3])
+    return None
+
+
+def _natural_L(*objs):
+    """The length at which to evaluate a pair of filter lists.
+
+    A filter list is only meaningful at *its own* ``L``, and neither side
+    carries it: NumPy leaves ``H`` as a callable that will regenerate at
+    whatever length it is asked for, and torch materialises ``H`` at the length
+    the designer chose.  So the materialised side is the one that knows, and its
+    ``len(H)`` is the answer.
+
+    Getting this wrong is not a loud failure, it is a *false alarm*: evaluating
+    an ``audfilters`` bank at the fixture's L = 512 instead of the designer's
+    L = 648 reports a 7.6e-2 divergence for two banks that agree to 0.0 channel
+    by channel.  A parity harness that cries wolf gets muted, so the length is
+    derived rather than assumed, and ``None`` is returned when neither side can
+    say — in which case the filter list is skipped and the caller is told.
+    """
+    lengths = []
+    for o in objs:
+        if not _is_filter_list(o):
+            continue
+        for gm in o:
+            H = gm.get("H")
+            if isinstance(H, torch.Tensor):
+                lengths.append(int(H.numel()))
+            elif isinstance(H, np.ndarray) and H.ndim == 1 and H.size:
+                lengths.append(int(H.size))
+    # Only when every materialised response has the *same* length is that length
+    # an ``L``.  Filters stored at their compact support have per-channel lengths
+    # (11, 17, 19, 21, ... for an ERB bank), and picking any one of them — first,
+    # longest, whatever — evaluates the two sides at different things and reports
+    # a 5.4e-2 divergence between banks that are identical.  When the lengths
+    # disagree, the honest answer is that this object does not say what L is.
+    if not lengths:
+        return None
+    return lengths[0] if len(set(lengths)) == 1 else None
+
+
+def _flatten(o, L, other=None, L_authoritative=False):
+    """Anything -> a flat complex array, or None if it carries no numbers.
+
+    ``other`` is the corresponding object from the *other* backend, used only to
+    resolve the evaluation length of a filter list (see :func:`_natural_L`).
+    """
+    if o is None or isinstance(o, str) or callable(o):
+        return None
+    if _is_filter_list(o):
+        # An L that came from the object's own designer tuple wins over anything
+        # inferred from the filters.  Where neither is available the filter list
+        # is *skipped* rather than evaluated at a guessed length — see
+        # ``test_filter_lists_without_a_known_L_are_skipped_not_guessed`` for why
+        # that loses no coverage.
+        if L_authoritative:
+            return _filters_to_array(o, L)
+        use_L = _natural_L(o, other)
+        return None if use_L is None else _filters_to_array(o, use_L)
+    if isinstance(o, torch.Tensor):
+        o = o.detach().cpu().numpy()
+    if isinstance(o, (bool, np.bool_)):
+        return np.atleast_1d(np.asarray(float(o), dtype=complex))
+    if isinstance(o, (int, float, complex, np.number)):
+        return np.atleast_1d(np.asarray(o, dtype=complex))
+    if isinstance(o, np.ndarray):
+        return np.asarray(o).ravel().astype(complex)
+    if isinstance(o, dict):
+        keys = sorted(o)
+        parts = [
+            _flatten(o[k], L, other.get(k) if isinstance(other, dict) else None) for k in keys
+        ]
+    elif isinstance(o, (list, tuple)):
+        oth = (
+            other if isinstance(other, (list, tuple)) and len(other) == len(o) else [None] * len(o)
+        )
+        dL = _designer_L(o)
+        inner_L = L if dL is None else dL
+        parts = [_flatten(v, inner_L, w, L_authoritative=dL is not None) for v, w in zip(o, oth)]
+    else:
+        try:
+            return np.atleast_1d(np.asarray(o)).ravel().astype(complex)
+        except Exception:
+            return None
+    parts = [p for p in parts if p is not None and p.size]
+    return np.concatenate(parts) if parts else None
+
+
+def _relerr(an, at):
+    scale = max(float(np.max(np.abs(an))) if an.size else 0.0, 1e-30)
+    return float(np.max(np.abs(an - at))) / scale if an.size else 0.0
+
+
+# ---------------------------------------------------------------------------
+# Surface enumeration
+# ---------------------------------------------------------------------------
+
+
+def _surface():
+    """{subpackage: {'numpy': {names}, 'torch': {names}}} for the public API."""
+    out = {}
+    for s in SUBPACKAGES:
+        row = {}
+        for be in ("numpy", "torch"):
+            m = importlib.import_module(f"cool_frames.{be}.{s}")
+            names = getattr(m, "__all__", None)
+            if names is None:
+                names = [n for n in dir(m) if not n.startswith("_")]
+            row[be] = {n for n in names if callable(getattr(m, n, None))}
+        out[s] = row
+    return out
+
+
+def _shared():
+    return sorted(
+        f"{s}::{n}" for s, row in _surface().items() for n in (row["numpy"] & row["torch"])
+    )
+
+
+# ---------------------------------------------------------------------------
+# The two enforcement tests — the reason this file does not rot
+# ---------------------------------------------------------------------------
+
+
+def test_public_surface_divergence_is_recorded():
+    """The set of names in one backend and not the other must match the record.
+
+    This is the test that catches "added to NumPy, forgotten in torch" on the
+    day it happens rather than two releases later.  It fails in *both*
+    directions: a new divergence fails because it is not in the record, and a
+    divergence that gets resolved fails because the record still claims it.
+    Either way the answer is to edit ``NUMPY_ONLY`` / ``TORCH_ONLY`` deliberately
+    and say why in the comment.
+    """
+    surface = _surface()
+    problems = []
+    for s, row in surface.items():
+        actual_n = row["numpy"] - row["torch"]
+        actual_t = row["torch"] - row["numpy"]
+        rec_n = NUMPY_ONLY.get(s, set())
+        rec_t = TORCH_ONLY.get(s, set())
+
+        for name in sorted(actual_n - rec_n):
+            problems.append(
+                f"  {s}.{name}: exists in NumPy only and is not recorded. "
+                f"Either implement it for torch, or add it to NUMPY_ONLY['{s}'] with a reason."
+            )
+        for name in sorted(actual_t - rec_t):
+            problems.append(
+                f"  {s}.{name}: exists in torch only and is not recorded. "
+                f"Either implement it for NumPy, or add it to TORCH_ONLY['{s}'] with a reason."
+            )
+        for name in sorted(rec_n - actual_n):
+            problems.append(
+                f"  {s}.{name}: recorded as NumPy-only but is no longer. "
+                f"Remove it from NUMPY_ONLY['{s}'] — and add a driver, since it is now shared."
+            )
+        for name in sorted(rec_t - actual_t):
+            problems.append(
+                f"  {s}.{name}: recorded as torch-only but is no longer. "
+                f"Remove it from TORCH_ONLY['{s}'] — and add a driver, since it is now shared."
+            )
+
+    assert not problems, "the backends' public surfaces have drifted:\n" + "\n".join(problems)
+
+
+def test_every_shared_symbol_has_a_parity_driver():
+    """No shared symbol may go uncompared.
+
+    A driver is three lines.  The alternative — a symbol that exists in both
+    backends and is compared by nothing — is the exact condition under which
+    all six of the recorded defects survived.
+    """
+    shared = set(_shared())
+    missing = sorted(shared - set(DRIVERS))
+    stale = sorted(set(DRIVERS) - shared)
+
+    assert not missing, (
+        "these symbols exist in both backends but have no parity driver:\n"
+        + "\n".join(f"  {k}" for k in missing)
+        + "\n\nAdd an entry to DRIVERS mapping (fixture, backend) -> (args, kwargs)."
+    )
+    assert not stale, "these DRIVERS entries no longer name a shared symbol:\n" + "\n".join(
+        f"  {k}" for k in stale
+    )
+
+
+# ---------------------------------------------------------------------------
+# The comparison itself
+# ---------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize("key", sorted(DRIVERS))
+def test_backends_agree(key, X):
+    """Drive one shared symbol in both backends and compare the results.
+
+    Both backends run in float64, so the bar is 1e-8 relative — six orders of
+    magnitude of slack over accumulated rounding, and tight enough that a
+    float32 path (which is how ``spsi`` was failing, at 8.8e-6) cannot hide.
+    """
+    sub, name = key.split("::")
+    drv = DRIVERS[key]
+
+    outs = {}
+    for be in ("numpy", "torch"):
+        mod = importlib.import_module(f"cool_frames.{be}.{sub}")
+        args, kwargs = drv(X, be)
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore")
+            outs[be] = getattr(mod, name)(*args, **kwargs)
+
+    an = _flatten(outs["numpy"], X["L"], outs["torch"])
+    at = _flatten(outs["torch"], X["L"], outs["numpy"])
+
+    if an is None and at is None:
+        pytest.skip(f"{key}: neither backend returns comparable numbers")
+
+    assert an is not None and at is not None, (
+        f"{key}: one backend returned comparable numbers and the other did not "
+        f"(numpy {'None' if an is None else an.shape}, torch {'None' if at is None else at.shape})"
+    )
+
+    if key in STRUCTURAL_ONLY:
+        return  # shape agreement is all that is claimed; see the dedicated test
+
+    assert an.shape == at.shape, f"{key}: numpy returned {an.shape}, torch returned {at.shape}"
+    err = _relerr(an, at)
+    assert err < RTOL, (
+        f"{key}: backends differ by {err:.3e} relative (tolerance {RTOL:.0e}). "
+        f"Both run in float64; an error this size is an algorithmic difference, "
+        f"not rounding. Check for int-tensor/Python-float promotion (which "
+        f"silently drops to the default dtype, float32) before assuming otherwise."
+    )
+
+
+# ---------------------------------------------------------------------------
+# The exceptions, each with its own claim
+# ---------------------------------------------------------------------------
+
+
+def test_decolbfgs_agrees_in_quality_not_in_iterates(X):
+    """``decolbfgs`` is allowed to differ, but only within a bound, and not silently.
+
+    NumPy's L-BFGS and torch's are different implementations with different line
+    searches, so the two backends legitimately land in different local minima of
+    the same non-convex problem.  What is *not* legitimate is an arbitrary gap,
+    so the claim made here is on the outcome: both must reach comparable
+    consistency.
+
+    Also pinned: the two keep different iteration histories.  For ``maxit=3``
+    NumPy returns four ``relres`` entries and torch five, and the values diverge
+    from the first iterate (0.880 vs 0.915) while both report ``niter=3``.  A
+    caller plotting convergence gets a different curve per backend. Recorded
+    rather than fixed — reconciling the bookkeeping is a return-contract change,
+    like the RTISIL ``relres`` question.
+    """
+    import cool_frames.numpy.phase as NP
+    import cool_frames.torch.phase as TP
+    from cool_frames.numpy.filterbanks import filterbank, filterbankdual, ifilterbank
+    from cool_frames.numpy.phase import magnitudeerrdb
+
+    kw = dict(L=X["L"], Ls=LS, real=X["real"], maxit=3)
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        cn, _fn, rn, itn = NP.decolbfgs(X["mag"], X["g"], X["a"], **kw)
+        ct, _ft, rt, itt = TP.decolbfgs(_t(X["mag"]), X["g"], X["a"], **kw)
+
+    gd = filterbankdual(X["g"], X["a"], X["L"], real=X["real"])
+
+    def consistency(coefs):
+        coefs = [np.asarray(x.detach().cpu() if hasattr(x, "detach") else x) for x in coefs]
+        f = ifilterbank(coefs, gd, X["a"], LS, real=X["real"])
+        return float(
+            magnitudeerrdb(filterbank(np.real(np.asarray(f)), X["g"], X["a"], X["L"]), X["mag"])
+        )
+
+    en, et = consistency(cn), consistency(ct)
+    assert en < 0.0 and et < 0.0, (
+        f"decolbfgs retrieved no phase: numpy {en:.2f} dB, torch {et:.2f} dB"
+    )
+    assert abs(en - et) < 3.0, (
+        f"decolbfgs backends reached {en:.2f} dB and {et:.2f} dB — a gap this large is "
+        "more than two line searches disagreeing"
+    )
+
+    # The bookkeeping divergence, pinned.
+    rn = np.atleast_1d(np.asarray(rn))
+    rt = np.atleast_1d(np.asarray(rt.detach().cpu() if hasattr(rt, "detach") else rt))
+    assert int(itn) == int(itt) == 3, "both backends should report the requested iteration count"
+    assert len(rn) != len(rt), (
+        "decolbfgs's relres histories are now the same length — if the bookkeeping was "
+        "reconciled, delete this assertion and document the change in the return contract"
+    )
+
+
+def test_filter_lists_are_compared_by_response_not_by_representation(X):
+    """Guard the comparator's own assumption, so a silent no-op cannot creep in.
+
+    ``_filters_to_array`` is what lets the designers be compared at all: NumPy
+    stores ``H`` as a callable for audfilters/cqtfilters/waveletfilters and
+    torch materialises it, so a field-by-field comparison would either fail on
+    every designer or, worse, quietly compare nothing. This asserts the
+    evaluation path is actually reached and actually produces numbers.
+    """
+    from cool_frames.numpy.filters import audfilters as np_aud
+    from cool_frames.torch.filters import audfilters as t_aud
+
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        gn, _a, _fc, L, _i = np_aud(FS, LS, M=8)
+        gt, _a2, _fc2, _L2, _i2 = t_aud(FS, LS, M=8)
+
+    assert _is_filter_list(gn) and _is_filter_list(gt), (
+        "fixture assumption: both return filter lists"
+    )
+    assert any(callable(g["H"]) for g in gn), (
+        "NumPy audfilters no longer stores H lazily — the comparator's reason for existing "
+        "has changed; check whether _filters_to_array is still needed"
+    )
+    arr_n, arr_t = _filters_to_array(gn, L), _filters_to_array(gt, L)
+    assert arr_n.size > 0 and arr_n.shape == arr_t.shape
+    assert np.max(np.abs(arr_n)) > 0, (
+        "evaluated filter responses are all zero — comparator is a no-op"
+    )
+
+
+def test_filter_lists_without_a_known_L_are_skipped_not_guessed(X):
+    """The one place the comparator declines to compare, and why that is safe.
+
+    ``filterbank_spectrogram`` returns its filter list in a plain dict, with no
+    ``L`` anywhere in the return value, and the torch side materialises each
+    filter at its own compact support (11, 17, 19, 21, ... bins for an ERB bank)
+    rather than at full band.  There is therefore no length at which the two
+    lists can be evaluated against each other, and ``_flatten`` skips them.
+
+    That is safe for one specific reason, asserted here rather than assumed:
+    ``coeff_db`` *is* the filters applied to a signal.  A divergence in the bank
+    could not survive in the coefficients, and the coefficients are compared to
+    1e-14.  This test fails if that stops being true — if ``coeff_db`` ever
+    disappears from the return value, or stops being derived from ``g`` — at
+    which point the skip becomes a real gap and the comparator needs an L.
+    """
+    import cool_frames.numpy.diagnostics as ND
+    import cool_frames.torch.diagnostics as TD
+
+    with warnings.catch_warnings():
+        warnings.simplefilter("ignore")
+        sn = ND.filterbank_spectrogram(X["sig"], FS)
+        st = TD.filterbank_spectrogram(torch.as_tensor(X["sig"]), FS)
+
+    assert _is_filter_list(sn["g"]) and _is_filter_list(st["g"])
+    assert _natural_L(sn["g"], st["g"]) is None, (
+        "the filter lists now agree on a single materialised length — the comparator "
+        "can evaluate them, so remove this exemption and let test_backends_agree cover it"
+    )
+
+    # The claim that makes the skip safe.
+    cn = np.asarray(sn["coeff_db"])
+    ct = np.asarray(st["coeff_db"].detach().cpu())
+    assert cn.size > 0 and cn.shape == ct.shape, "coeff_db must be present and comparable"
+    assert _relerr(cn.ravel().astype(complex), ct.ravel().astype(complex)) < RTOL, (
+        "coeff_db no longer agrees — the filter banks differ after all, and the skipped "
+        "filter-list comparison is now a real gap"
+    )
+
+
+@pytest.mark.parametrize("backend", ["numpy", "torch"])
+def test_framemuleigs_is_reproducible(backend, X):
+    """The same multiplier must give the same eigenvalues twice.
+
+    ``framemuleigs`` falls back to ARPACK (``scipy.sparse.linalg.eigsh``) for
+    large ``L``, and ARPACK starts from a *random* vector unless it is given
+    one.  Both backends called it without a ``v0``, so both returned a different
+    answer run to run — measured 3.83465916 against 3.84270865 for the same
+    fourth eigenvalue, 2e-3 apart, an unconverged iterate on one draw and a
+    converged one on the next.  Frame multipliers have degenerate spectra
+    whenever ``sigma`` is constant, which is the common case, so this was not a
+    corner.
+
+    This test exists separately from ``test_backends_agree`` because the parity
+    comparison only catches non-determinism *when the dice fall badly* — it
+    passed on one run and failed on the next while the defect was present.  A
+    property this file asserts must not depend on luck, so reproducibility is
+    checked directly, by calling twice and demanding bit-identical output.
+    """
+    if backend == "torch":
+        sigma = _t(X["sigma"])
+        import cool_frames.torch.operators as mod
+    else:
+        sigma = X["sigma"]
+        import cool_frames.numpy.operators as mod
+
+    def run():
+        with warnings.catch_warnings():
+            warnings.simplefilter("ignore")
+            out = mod.framemuleigs(X["g"], X["g"], X["a"], sigma, X["L"], 4, real=X["real"])
+        return np.asarray(out.detach().cpu() if hasattr(out, "detach") else out).ravel()
+
+    first, second = run(), run()
+    assert np.array_equal(first, second), (
+        f"{backend}.framemuleigs returned different eigenvalues on two identical calls:\n"
+        f"  {first}\n  {second}\n"
+        "The iterative eigensolver needs a deterministic start vector (v0)."
+    )
